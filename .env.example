# ─── Database (required) ────────────────────────────────────────────────
# Postgres. On Vercel, adding Neon from the Storage tab fills DATABASE_URL
# (and DATABASE_URL_UNPOOLED, used for migrations) for you.
DATABASE_URL="postgresql://postgres@localhost:5433/pulse"
# optional: a direct (unpooled) URL for migrations
DIRECT_URL=""

# ─── Sign-in (required) ─────────────────────────────────────────────────
# A long random string: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The app's public address. On Vercel you can leave it empty; the Vercel URL is used.
BETTER_AUTH_URL="http://localhost:3000"

# ─── Reminder engine (required in production) ───────────────────────────
# Protects /api/cron/tick. Any long random string; give the same value to the scheduler.
CRON_SECRET=""
# Locally (or on your own server) the app can tick itself every minute. Keep it off on Vercel.
ENGINE_INTERNAL_TICK="1"

# ─── Push notifications (recommended) ───────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourcompany.com"
# Signs the Acknowledge / Snooze buttons on notifications (falls back to BETTER_AUTH_SECRET)
PUSH_TOKEN_SECRET=""

# ─── Demo company (optional) ────────────────────────────────────────────
# "1" loads Crescent Distributors (20 staff) and shows one-tap demo sign-in.
# Leave it "0" for a real company: each deploy then removes any demo data.
PULSE_DEMO="0"
SEED_PASSWORD="choose-a-demo-password"

# ─── Files (optional) ───────────────────────────────────────────────────
# With a Vercel Blob store connected, uploads go there; otherwise into Postgres.
BLOB_READ_WRITE_TOKEN=""

# ─── Email digests (optional) ───────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Pulse <pulse@yourcompany.com>"
