# Postgres (Neon in production). DIRECT_URL is the non-pooled URL used for migrations.
DATABASE_URL="postgresql://postgres@localhost:5433/pulse"
DIRECT_URL="postgresql://postgres@localhost:5433/pulse"

# Better Auth: a long random string (openssl rand -base64 32) and the public URL of the app
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Demo company (Crescent Distributors): one-tap demo logins and the Reset button
DEMO_MODE="1"
SEED_PASSWORD="choose-a-demo-password"

# Web Push (step 3). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
